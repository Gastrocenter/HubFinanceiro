# Copie para .env.local e preencha. NUNCA versionar .env nem .env.local.

# ProDoctor: uma chave por empresa (CNPJ). Troque EMPRESA pelo nome curto, ex.: PRODOCTOR_SABIN_APIKEY.
PRODOCTOR_EMPRESA_APIKEY=
PRODOCTOR_EMPRESA_APIPASSWORD=

# Supabase (URL e chave publicável são públicas; a secret só no servidor)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
